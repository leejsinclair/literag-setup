# =============================================================================
# LiteRAG Setup — configuration template
# =============================================================================
# Copy to `.env` and edit for this machine:   cp .env.example .env
# Then:  chmod 0644 .env   (the image's `lightrag` user, uid 1000, must read it)
#
# `.env` is the SINGLE authoritative configuration surface. It is:
#   1. read by Docker Compose for ${...} interpolation in compose.yaml, and
#   2. mounted read-only at /app/.env and loaded by the LightRAG server at startup.
# compose.yaml has NO `environment:` block — do not re-declare any key there.
#
# `.env` is gitignored (secrets + host-specific state). This file is the committed
# template (FR-029, FR-030, Principle VI).
#
# Verified against the official LightRAG env.example / docs at tag v1.5.6
# (Principle VIII). Sources: research.md → Sources.
#
# PERFORMANCE PROFILE: this box has an NVIDIA GTX 1660 Ti (6 GB). Ollama is
# deliberately GPU-accelerated and tuned (see ollama/ollama.service and
# docs/MODEL_SELECTION.md → "Performance tuning"). The original CPU-only
# profile lives in git history if you ever move to a machine without a GPU.
# =============================================================================

# --- Image (pinned; only scripts/update.sh changes this) ---------------------
# Default (non-lite) variant: bundles spaCy models + the offline legacy PDF/text
# parser. Do NOT use a `-lite` tag (needs external MinerU/Docling services).
# Resolved digest for v1.5.6 (record any change in docs/ARCHITECTURE.md):
#   sha256:ab23a9c83a735901b18c8960b6b482b602d5b6291abb7e07c5776f7bb2da504e
LIGHTRAG_IMAGE_TAG=v1.5.6

# --- Network binding --------------------------------------------------------
# compose.yaml uses `network_mode: host`, so the LightRAG process binds HOST:PORT
# directly. Keep HOST at loopback — it is the ONLY access control (no auth).
# ⚠  Moving HOST off 127.0.0.1 exposes an UNAUTHENTICATED server. Set
#    LIGHTRAG_API_KEY (below) BEFORE you ever change this (FR-028, FR-028a).
HOST=127.0.0.1
PORT=9621

# --- Container-side paths (match the bind mounts in compose.yaml; do not change)
WORKING_DIR=/app/data/rag_storage
INPUT_DIR=/app/data/inputs
PROMPT_DIR=/app/data/prompts

# --- Query / extraction LLM (host Ollama) -----------------------------------
LLM_BINDING=ollama
LLM_BINDING_HOST=http://localhost:11434
# LLM_BINDING_API_KEY=            # not needed for a local Ollama
LLM_MODEL=qwen2.5:3b-instruct
# Force EVERY transformer layer onto the GPU. Without this, Ollama's scheduler
# leaves ~9% of qwen2.5:3b on the CPU at large contexts, which stalls the whole
# pipeline (GPU waits on CPU layers and vice-versa) and pins utilisation near
# 10%. 99 = "offload up to 99 layers" = all of them. Confirm with `ollama ps`
# showing "100% GPU". Same knob for the embedding model below.
OLLAMA_LLM_NUM_GPU=99
# Context window. 12288 covers the trimmed query context (MAX_TOTAL_TOKENS below
# is 10000, plus the prompt and headroom) and extraction (chunk ~2000 tok +
# prompt, gleaning disabled → ~4k input). It is also the largest value at which
# the LLM and bge-m3 both stay resident on the 6 GB card with OLLAMA_NUM_PARALLEL=1
# (verified: qwen 2.4 GB + bge-m3 0.66 GB + desktop → ~4.8/6.1 GB, both "100% GPU").
# Do NOT raise this without also lowering something else — see the eviction note in
# ollama/ollama.service.
OLLAMA_LLM_NUM_CTX=12288
# Cap generation length. qwen2.5:3b (and similar small models) can enter a
# repetition loop on LightRAG's structured-extraction prompt and generate until
# it times out, FAILING the document (verified on the target, T034). Two guards:
#   1. REPEAT_PENALTY 1.15 (default 1.1) nudges it out of the loop without
#      distorting the structured-tuple output (1.3 was observed to make qwen drop
#      fields — "found 4/5 fields on RELATION" warnings).
#   2. NUM_PREDICT 3072 bounds any residual runaway to ~40s at ~80 tok/s and is
#      still ample for a full Q&A answer. Lower NUM_PREDICT further if extractions
#      still crawl; raise it only if real answers get cut off mid-sentence.
OLLAMA_LLM_NUM_PREDICT=3072
OLLAMA_LLM_REPEAT_PENALTY=1.15
# Inference is GPU-backed but this is an entry-level card. 0 = no timeout.
LLM_TIMEOUT=1200
# Concurrent LLM calls / documents in flight. Ollama serves 1 request per model
# (OLLAMA_NUM_PARALLEL=1 — the card cannot hold a second KV slot), so 2/1 means
# one call runs while the next is prepared. Higher just deepens the queue and
# starves the embedding model of GPU time. Upstream defaults are 4/3.
MAX_ASYNC_LLM=2
MAX_PARALLEL_INSERT=1

# --- Embedding model (host Ollama) -----------------------------------------
EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://localhost:11434
EMBEDDING_MODEL=bge-m3:latest
# ⚠  EMBEDDING_DIM MUST equal the model's native dimension. bge-m3 = 1024.
#    Changing EMBEDDING_MODEL almost always changes this and INVALIDATES the
#    vector index — a re-index is then required (FR-025). See docs/MODEL_SELECTION.md.
EMBEDDING_DIM=1024
# 2048 is ample: the longest thing embedded is a merged entity/relation summary,
# capped at SUMMARY_MAX_TOKENS=1000. 8192 just reserved VRAM that the LLM needed.
OLLAMA_EMBEDDING_NUM_CTX=2048
OLLAMA_EMBEDDING_NUM_GPU=99
# Texts per /api/embed call. 10 (the upstream default) keeps each call short; a
# 32-text batch of long merge-phase summaries was the exact call that exceeded
# LightRAG's 60 s embedding-worker ceiling and halted the pipeline. Concurrency 2
# because Ollama serves 1 embed request at a time (OLLAMA_NUM_PARALLEL=1).
EMBEDDING_BATCH_NUM=10
EMBEDDING_FUNC_MAX_ASYNC=2
# Hard ceiling for a single embedding batch. LightRAG's worker timeout is 2x this
# (so 240 s). Default is 30. Raised so a transient slow batch — model still warming,
# GPU busy with an extraction call — does not fail the whole document.
EMBEDDING_TIMEOUT=120

# --- Retrieval / query context (top-priority latency knobs) -----------------
# The answer LLM must prompt-process the ENTIRE assembled context before it emits
# a token. This card does ~300 tok/s prompt eval, so the default 30000-token
# budget alone costs ~90-110s per query. These cuts trade a little retrieval
# breadth for a ~3x faster query. Raise any of them back toward the upstream
# default if answers start missing information. Upstream defaults, in order:
# MAX_TOTAL_TOKENS 30000, MAX_ENTITY_TOKENS 6000, MAX_RELATION_TOKENS 8000,
# TOP_K 40, CHUNK_TOP_K 20, RELATED_CHUNK_NUMBER 5.
MAX_TOTAL_TOKENS=10000
MAX_ENTITY_TOKENS=2500
MAX_RELATION_TOKENS=3000
TOP_K=20
CHUNK_TOP_K=8
RELATED_CHUNK_NUMBER=3

# --- Ingestion chunking / extraction depth (aggressive-speed profile) -------
# Fewer, larger chunks and no second-pass "gleaning" roughly halve the LLM calls
# per document, at the cost of some fine-grained entities/relations. If graph
# quality drops too far, step back: MAX_GLEANING=1 and CHUNK_SIZE=1600 first.
# Upstream defaults: MAX_GLEANING 1, CHUNK_SIZE 1200, CHUNK_OVERLAP_SIZE 100,
# FORCE_LLM_SUMMARY_ON_MERGE 8, SUMMARY_MAX_TOKENS 1200.
MAX_GLEANING=0
CHUNK_SIZE=2000
CHUNK_OVERLAP_SIZE=200
FORCE_LLM_SUMMARY_ON_MERGE=12
SUMMARY_MAX_TOKENS=1000

# --- Storage backends (default file-based; all state under WORKING_DIR) ------
# Set explicitly so the choice is visible and pinned. Changing any of these to a
# database is a discrete, spec-driven change (Principle IX) and needs a new
# backup strategy.
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage

# --- Parser routing --------------------------------------------------------
# Upstream default. `native` handles .md/.txt fully locally; `legacy` (PyPDF
# family, bundled in the non-lite image) handles text-searchable .pdf offline.
# Scanned/image-only PDFs are out of scope (no OCR) and will be reported failed.
LIGHTRAG_PARSER=*:native-teP,*:legacy-R

# --- Behaviour -----------------------------------------------------------
# LLM response cache. ON: repeated/similar queries and re-ingests skip the model
# entirely. It was off for deterministic smoke-test runs; smoke-test.sh starts
# from an empty KB so the cache does not affect its assertions.
ENABLE_LLM_CACHE=true
ENABLE_LLM_CACHE_FOR_EXTRACT=true
#
# NOTE on startup ingestion (FR-002a): the LightRAG server (v1.5.6) does NOT
# scan or ingest on startup — a run is triggered only by `POST /documents/scan`
# (scripts/ingest.sh) or a Web UI upload. There is no file-watcher and no
# auto-scan env var to disable. Re-confirm this against the pinned image in T034.

# --- Web UI labels (cosmetic) --------------------------------------------
WEBUI_TITLE=LiteRAG Knowledge Base
WEBUI_DESCRIPTION=Local personal knowledge base (LightRAG)

# --- Authentication (DISABLED by design — clarification Q4, FR-028a) --------
# Access control is loopback binding ONLY. Set this to a strong secret BEFORE
# any decision to widen network exposure; every script must then send it as the
# `X-API-Key` header and contracts/lightrag-api.md must be revised.
# LIGHTRAG_API_KEY=change-me-before-any-network-exposure

# --- Script readiness tuning (read by scripts/lib/common.sh, not LightRAG) ---
# How long start.sh / restart.sh wait for GET /health to return 200.
# Contract default is 120s; raised here for CPU-only first starts (spaCy model
# load + LightRAG init). Lower it once you know your machine's warm-start time.
HEALTH_TIMEOUT_SECONDS=180
