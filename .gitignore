# --- Secrets / machine-specific configuration (FR-030, Principle VI) ---
.env
.env.*
!.env.example

# --- Knowledge-base data and source documents (never committed) ---
data/inputs/*
data/rag_storage/*
data/prompts/*
data/backups/*
data/kb-sync/*
data/models/*
packs/*

# kb-sync secrets: OAuth client and tokens, AppFlowy and Anthropic credentials (FR-004)
secrets/

# Displaced KB state left behind by restore.sh --force
data/rag_storage.pre-restore-*/

# Keep the directory skeleton tracked
!data/inputs/.gitkeep
!data/rag_storage/.gitkeep
!data/prompts/.gitkeep
!data/backups/.gitkeep
!data/kb-sync/.gitkeep
!data/models/.gitkeep
!packs/.gitkeep

# --- Editor / OS noise ---
*.swp
*~
.DS_Store
Thumbs.db

# --- Python tooling noise (kb-sync) ---
__pycache__/
.pytest_cache/
sync/.venv/
sync/uv.lock
